{
  "$schema": "https://opencode.ai/config.json",
  "model": "openrouter/openrouter/free",
  "provider": {
    "openrouter": {
      "options": {"apiKey": "{env:OPENROUTER_API_KEY}"},
      "models": {"openrouter/free": {"name": "OpenRouter gratuito"}}
    }
  },
  "mcp": {
    "radar": {
      "type": "local",
      "command": ["backend/.venv/Scripts/python.exe", "backend/radar_mcp.py"],
      "environment": {"RADAR_API_URL": "http://127.0.0.1:8000"},
      "enabled": true
    }
  }
}
