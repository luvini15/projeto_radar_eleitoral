APP_ENV=development
DATABASE_URL=postgresql+psycopg://radar:change_me@localhost:5433/radar_eleitoral
APIFY_TOKEN=

# Desenvolvimento local: scheduler embutido; Docker usa um único serviço externo.
COLLECTION_ENABLED=true
COLLECTION_SCHEDULER_MODE=embedded
# Horário diário
COLLECTION_DAILY_TIME=03:00
COLLECTION_TIMEZONE=America/Sao_Paulo
COLLECTION_POST_LIMIT=25

# Compatibilidade: campanhas abaixo usam intervalo no mesmo scheduler, em vez do horário diário.
AUTO_SYNC_CAMPAIGN_IDS=
AUTO_SYNC_INTERVAL_HOURS=6
AUTO_SYNC_POST_LIMIT=25

# IA: chave somente no servidor; limite de novas chamadas por dia UTC.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_DAILY_LIMIT=20
