APP_ENV=development
DATABASE_URL=postgresql+psycopg://radar:SUBSTITUA_SENHA@localhost:5433/radar_eleitoral
# Em producao, DATABASE_URL usa radar_app; MIGRATION_DATABASE_URL usa o owner.
MIGRATION_DATABASE_URL=
APP_DB_PASSWORD=
APIFY_TOKEN=
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=
# Novos usuarios autenticados sao cadastrados automaticamente como analistas.
# Use um e-mail administrativo apenas para o primeiro bootstrap; depois, a
# funcao e o bloqueio de contas ficam na tabela app_users.
ADMIN_EMAILS=
ADMIN_USER_IDS=
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# Desenvolvimento local: scheduler embutido; Docker usa um único serviço externo.
COLLECTION_ENABLED=true
COLLECTION_SCHEDULER_MODE=embedded
# Horário diário
COLLECTION_DAILY_TIME=03:00
COLLECTION_TIMEZONE=America/Sao_Paulo
COLLECTION_POST_LIMIT=25

# Compatibilidade: campanhas abaixo usam intervalo no mesmo scheduler, em vez do horário diário.
AUTO_SYNC_CAMPAIGN_IDS=
AUTO_SYNC_INTERVAL_HOURS=6
AUTO_SYNC_POST_LIMIT=25

# IA: chave somente no servidor; limite de novas chamadas por dia UTC.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_DAILY_LIMIT=20
