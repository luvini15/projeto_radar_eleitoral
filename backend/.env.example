DATABASE_URL=postgresql+psycopg://radar:SUBSTITUA_SENHA@localhost:5433/radar_eleitoral
# Somente desenvolvimento local. Nunca habilite em producao.
LOCAL_AUTH_BYPASS=false
# Em producao, DATABASE_URL usa radar_app; MIGRATION_DATABASE_URL usa o owner.
MIGRATION_DATABASE_URL=
APP_DB_PASSWORD=
APIFY_TOKEN=
APIFY_POSTS_ACTOR=themineworks/instagram-post-scraper
APIFY_PROFILE_ACTOR=apify/instagram-profile-scraper
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=
# Novos usuarios autenticados sao cadastrados automaticamente como analistas.
# Use um e-mail administrativo apenas para o primeiro bootstrap; depois, a
# funcao e o bloqueio de contas ficam na tabela app_users.
ADMIN_EMAILS=
ADMIN_USER_IDS=
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO
SESSION_IDLE_MINUTES=30
SESSION_MAX_HOURS=12

# Coleta automática: IDs de campanhas separados por vírgula; vazio desativa.
AUTO_SYNC_CAMPAIGN_IDS=
AUTO_SYNC_INTERVAL_HOURS=6
AUTO_SYNC_POST_LIMIT=25

# IA do painel: chave apenas no servidor; chamadas novas limitadas por dia UTC.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
AI_DAILY_LIMIT=20
