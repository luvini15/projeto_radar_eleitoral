radar.example.com {
    encode zstd gzip
    root * /srv/radar/dist

    @api path /api/* /health
    handle @api {
        reverse_proxy 127.0.0.1:8000
    }

    handle {
        try_files {path} /index.html
        file_server
    }

    header {
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.instagram.com https://*.cdninstagram.com https://*.fbcdn.net; connect-src 'self' https://SEU_PROJETO.supabase.co; frame-src https://www.instagram.com; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
    }
}
