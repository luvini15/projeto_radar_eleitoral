# Preparado para autenticação futura via Supabase Auth.
# Copie este arquivo para .env.local e preencha quando a integração real for ativada.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Backend do Radar Eleitoral (sem token Apify no frontend)
VITE_API_URL=http://localhost:8000

# Docker Compose: credenciais somente no .env local, nunca versionadas.
POSTGRES_PASSWORD=
DATABASE_URL_DOCKER=
COLLECTION_ENABLED=true
COLLECTION_DAILY_TIME=03:00
COLLECTION_TIMEZONE=America/Sao_Paulo
COLLECTION_POST_LIMIT=25
